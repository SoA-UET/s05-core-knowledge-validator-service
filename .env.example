# S05 Knowledge Validator Service Environment Variables

# ===================
# Database Configuration
# ===================
MONGO_URL=mongodb://localhost:27017/telcenter_core_s05

# ===================
# Message Queue Configuration
# ===================
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# A34 - Receive knowledge validation events from S12 (Partner)
UPDATE_VALIDATION_EVENT_QUEUE=update_validation_events

# A08 - Send validated knowledge to S03 (Knowledge Service)
KNOWLEDGE_STORE_EVENT_QUEUE=knowledge_store_events

# Number of MQ consumer worker threads
NUM_MQ_WORKERS=4

# ===================
# HTTP Server Configuration
# ===================
HTTP_HOST=0.0.0.0
HTTP_PORT=5005
FLASK_DEBUG=false

# ===================
# SeaweedFS Configuration
# ===================
SEAWEEDFS_MASTER_URL=http://localhost:9333
SEAWEEDFS_VOLUME_URL=http://localhost:8080

# ===================
# JWT Authentication Configuration
# ===================
# Identity Service URL for JWKS retrieval
IDENTITY_SERVICE_URL=http://localhost:5001

# JWKS cache TTL in minutes (default: 10)
JWKS_TTL_IN_MINUTES=10
